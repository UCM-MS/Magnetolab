[gd_resource type="Resource" script_class="LevelData" format=3]

[ext_resource type="Script" path="res://scripts/dialog_page.gd" id="2_page"]
[ext_resource type="Script" path="res://scripts/level_data.gd" id="3_level"]
[ext_resource type="Resource" path="res://resources/items/iron_key.tres" id="4_key"]

[sub_resource type="Resource" id="Resource_feedback0"]
script = ExtResource("2_page")
text = "Tentoraz nie. Drevo magnet nepriťahuje. Pritiahol sa železný kľúč, pretože magnet priťahuje železo."

[sub_resource type="Resource" id="Resource_feedback1"]
script = ExtResource("2_page")
text = "Správne! Kľúč je zo železa a magnet železo priťahuje. Drevo ani plast magnet nepriťahuje."
mood = 1

[sub_resource type="Resource" id="Resource_feedback2"]
script = ExtResource("2_page")
text = "Tentoraz nie. Plast magnet nepriťahuje. Pritiahol sa železný kľúč, pretože magnet priťahuje železo."

[sub_resource type="Resource" id="Resource_card"]
script = ExtResource("2_page")
title = "Čo si zistil"
text = "Magnet priťahuje predmety zo železa. Drevo ani plast nepriťahuje. Magnet pôsobí aj na diaľku, bez dotyku."
mood = 1

[resource]
script = ExtResource("3_level")
level_name = "Železo alebo nie?"
guess_check_item = ExtResource("4_key")
guess_feedback = Array[ExtResource("2_page")]([SubResource("Resource_feedback0"), SubResource("Resource_feedback1"), SubResource("Resource_feedback2")])
info_card = SubResource("Resource_card")
