script = ExtResource("2_page")
title = "Pravidlá laboratória"
text = "Kubo, zapamätaj si moje pravidlá:
1. Do priepasti nevstupuj!
2. Ťažké kovové bedne rukou nepohneš.
3. Keď sa zasekneš, stlač R."

