[gd_resource type="Resource" script_class="DialogData" format=3]

[ext_resource type="Script" path="res://scripts/dialog_data.gd" id="1_dialog"]
[ext_resource type="Script" path="res://scripts/dialog_page.gd" id="2_page"]

[sub_resource type="Resource" id="Resource_p0"]
script = ExtResource("2_page")
title = "Odhadni"
text = "Pozri, Kubo! Za priepasťou ležia tri predmety. Ktorý z nich pritiahne magnet?"
mood = 2
options = PackedStringArray("drevená kocka", "železný kľúč", "plastová fľaša")
correct_option = 1

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("2_page")
title = "Magnetická rukavica"
text = "Zaujímavý tip! Teraz ho over. Na ruke máš magnetickú rukavicu.

Medzerník – zapni / vypni
Q – prepni pól (S / J)
Rukavica pôsobí tam, kam sa pozeráš."
mood = 1

[resource]
script = ExtResource("1_dialog")
pages = Array[ExtResource("2_page")]([SubResource("Resource_p0"), SubResource("Resource_p1")])
