[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/hud.gd" id="1_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/dialog_box.tscn" id="2_dialog"]

[node name="HUD" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_hud")

[node name="InventoryPanel" type="PanelContainer" parent="."]
offset_left = 16.0
offset_top = 16.0
offset_right = 56.0
offset_bottom = 56.0

[node name="Margin" type="MarginContainer" parent="InventoryPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Content" type="VBoxContainer" parent="InventoryPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Caption" type="Label" parent="InventoryPanel/Margin/Content"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Inventár"

[node name="Slots" type="HBoxContainer" parent="InventoryPanel/Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="DialogBox" parent="." instance=ExtResource("2_dialog")]
